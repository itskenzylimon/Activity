# Upload sources, docs, examples and their intentional assets; omit local output.
# .pubignore replaces .gitignore for publishing, so nested patterns are explicit.
**/.git/**
**/.dart_tool/**
**/build/**
**/.pub/**
**/.pub-cache/**
**/.gradle/**
**/.cxx/**
**/.idea/**
**/.vscode/**
**/node_modules/**
**/Pods/**
**/.symlinks/**
**/ephemeral/**
**/DerivedData/**
**/.DS_Store
**/*.iml
**/*.ipr
**/*.iws
**/*.log
**/*.lock
**/*.symbols
**/*.map.json
**/*.app/**
**/*.apk
**/*.aab
**/*.ipa
**/*.dSYM/**
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.metadata
**/.env.*
**/*.jks
**/*.keystore
**/*.p12
**/*.mobileprovision
**/key.properties
**/local.properties
**/GoogleService-Info.plist
**/google-services.json
**/flutter_export_environment.sh
**/pubspec_overrides.yaml
**/xcuserdata/**
**/Generated.xcconfig
**/.last_build_id
**/.api_snippets/**
**/.web-assets/**
activity.iml
example/flutter_01.png
example/gallery-preview.jpg
doc/api/**
# Workspace-only gallery manifest needs the unpublished sibling QuickeyDB repo.
# The published standalone example uses only the root package dependencies.
example/pubspec.yaml

**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
